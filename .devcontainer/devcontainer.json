{
  // GitHub Codespaces: chạy thử bản Docker thật với dữ liệu demo + AI giả lập (không cần khóa API).
  "name": "Toán từng bước — chạy thử (demo)",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Toán từng bước (web)", "onAutoForward": "openBrowser" }
  },
  // Lần đầu: sinh khóa, build image, nạp demo. Mỗi lần mở lại: khởi động stack.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh"
}
