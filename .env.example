# Sao chép thành .env.local khi cần; KHÔNG ghi khóa thật vào file này.
# Local: `npm run db:start && npm run db:env` tự ghi hai biến dưới vào .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Không có biến secret/service-role cho ứng dụng (ADR-005).
# Integration test trên CI (tùy chọn; local tự đọc từ `supabase status`):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Tùy chọn cho E2E khi môi trường có sẵn Chromium khác version Playwright:
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/đường/dẫn/tới/chrome
# E2E_PORT=3100
