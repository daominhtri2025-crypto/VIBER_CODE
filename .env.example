# Sao chép file này thành .env và điền giá trị thật. KHÔNG commit file .env.

# Khóa JWT (chuỗi ngẫu nhiên dài >= 32 ký tự)
SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Khóa Fernet để mã hóa nội dung tố giác (NFR-03)
# Tạo khóa trên Windows PowerShell:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Mật khẩu PostgreSQL (dùng trong docker-compose)
POSTGRES_PASSWORD=thay-bang-mat-khau-manh

# Chỉ dùng khi chạy local không Docker (mặc định: SQLite)
# DATABASE_URL=sqlite:///./scam_shield.db
