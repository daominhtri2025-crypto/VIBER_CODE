# Copy to .env (never commit real values). All secrets live ONLY in the environment.
APP_DB_PATH=data/app.db
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600

# Google login (optional). Only links to EXISTING accounts; no auto-provisioning.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=          # e.g. fpt.edu.vn ; empty = any domain

# AI — Anthropic Claude (Haiku 5.5 via ai_configs). Paid API key from Console.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=8
AI_QUOTA_PER_SESSION=30
AI_QUOTA_PER_STUDENT_PER_DAY=100
AI_DAILY_BUDGET_USD=5

# Backups (encrypted, rolling 30 days) and erasure ledger (outside the DB and backup dir)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
BACKUP_KEY=                      # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ERASURE_LEDGER_PATH=ops/erasure_ledger.jsonl
CORS_ORIGINS=http://localhost:3000
